[Unit]
Description=ESocial - servidor web (FastAPI/uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
User=esocial
Group=esocial
WorkingDirectory=/opt/safework/ESocial

# 1 worker de proposito: o SQLite e a thread de background do "Atualizar dados"
# nao funcionam bem com multiplos workers.
# Porta 8001: nesta VPS a 80/8000/8080 ja sao de outros servicos (Docker/nginx).
# Num servidor com a 80 livre, use --port 80 + AmbientCapabilities=CAP_NET_BIND_SERVICE.
ExecStart=/opt/safework/ESocial/.venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 8001 --workers 1

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
